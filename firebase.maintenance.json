{
  "hosting": [
    {
      "target": "development",
      "public": ".",
      "ignore": [
        "firebase.json",
        "firebase.maintenance.json",
        "**/.*",
        "**/node_modules/**",
        "index.html",
        "404.html",
        "account/**",
        "admin/**",
        "legal/**",
        "management/**",
        "shop/**",
        "system/**",
        "functions/**",
        "plan/**",
        "*.md",
        "*.ps1",
        "*.json"
      ],
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "**",
          "destination": "/maintenance/index.html"
        }
      ]
    },
    {
      "target": "production",
      "public": ".",
      "ignore": [
        "firebase.json",
        "firebase.maintenance.json",
        "**/.*",
        "**/node_modules/**",
        "index.html",
        "404.html",
        "account/**",
        "admin/**",
        "legal/**",
        "management/**",
        "shop/**",
        "system/**",
        "functions/**",
        "plan/**",
        "*.md",
        "*.ps1",
        "*.json"
      ],
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "**",
          "destination": "/maintenance/index.html"
        }
      ]
    }
  ]
}
